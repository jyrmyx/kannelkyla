---
import Base from './Base.astro';

interface Props {
  title: string;
  eyebrow?: string;
  wide?: boolean;
}

const { title, eyebrow, wide = false } = Astro.props;
---

<Base title={title}>
  <article class:list={['mx-auto px-5 py-12 md:py-16', wide ? 'max-w-5xl' : 'max-w-3xl']}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl font-serif text-4xl tracking-tight text-ink md:text-5xl">{title}</h1>
    <slot />
  </article>
</Base>
