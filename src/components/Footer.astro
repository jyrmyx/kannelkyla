---
import { nav, url } from '../lib/site';
---

<footer class="mt-20 bg-forest text-cream">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-3">
    <div>
      <p class="font-serif text-3xl">Kannelkylä</p>
      <p class="mt-3 max-w-xs text-cream/80">
        Asunto Oy Kannelmäen Pientalot<br />
        Vanhaistentie 12–14<br />
        00420 Helsinki
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold tracking-[0.14em] text-cream/60 uppercase">Sivut</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2">
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} class="text-cream/90 underline-offset-4 hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold tracking-[0.14em] text-cream/60 uppercase">Yhteys</p>
      <ul class="mt-3 space-y-2 text-cream/90">
        <li>
          Isännöitsijä
          <a class="underline-offset-4 hover:underline" href="tel:+358442057935">044 205 7935</a>
        </li>
        <li>
          Huolto
          <a class="underline-offset-4 hover:underline" href="tel:+358102708250">010 270 8250</a>
        </li>
        <li>
          <a class="underline-offset-4 hover:underline" href="https://www.facebook.com/groups/kannelkyla">
            Facebook-ryhmä
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-5 py-5 text-sm text-cream/60">
      Sisältö ja kuvat ovat taloyhtiön nykyiseltä sivustolta. Sivuston toteutus:
      <a class="text-cream/80 underline-offset-4 hover:underline" href="https://ilama.dev">iLama Oy</a>
    </p>
  </div>
</footer>
