---
interface Props {
  title: string;
  images: string[];
}

const { title, images } = Astro.props;
---

<section class="mt-14">
  <h2 class="font-serif text-3xl tracking-tight text-forest">{title}</h2>
  <ul class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3">
    {
      images.map((src, index) => (
        <li>
          <button
            type="button"
            class="group block w-full overflow-hidden rounded-2xl bg-line"
            data-lightbox={src}
            data-caption={`${title}, kuva ${index + 1}`}
            aria-label={`Avaa ${title}, kuva ${index + 1}`}
          >
            <img
              src={src}
              alt=""
              class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </button>
        </li>
      ))
    }
  </ul>
</section>
