---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { categories, formatDate, url } from '../lib/site';

const news = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const latest = news.slice(0, 4);
const living = await getCollection('living');

const quick = ['pesutupa', 'kerhohuone', 'saunavuorot', 'kuntosali', 'jatehuolto', 'kylakartta']
  .map((id) => {
    if (id === 'kylakartta') return { href: url('/kylakartta'), title: 'Kyläkartta', description: 'Talojen tunnukset ja pysäköinti.' };
    const entry = living.find((item) => item.id === id);
    return entry
      ? { href: url(`/asuminen/${entry.id}`), title: entry.data.title, description: entry.data.description }
      : null;
  })
  .filter((item) => item !== null);

const stats = [
  { value: '1974', label: 'valmistui' },
  { value: '31', label: 'taloa' },
  { value: '500+', label: 'asukasta' },
  { value: '5 ha', label: 'tontti' },
];
---

<Base title="Kannelkylä" home>
  <section class="relative">
    <img
      src={url('/media/kevat.jpg')}
      alt="Omenapuun kukkia Kannelkylässä. Taustalla näkyy punainen puutalo."
      class="h-[62vh] min-h-[420px] w-full object-cover object-[center_35%]"
    />
  </section>

  <section class="relative z-10 mx-auto -mt-24 max-w-6xl px-5">
    <div class="rounded-[2rem] border border-white/70 bg-cream px-6 py-8 shadow-xl shadow-forest/10 md:px-12 md:py-12">
      <p class="eyebrow">Helsinki · Kannelmäki</p>
      <h1 class="mt-3 max-w-4xl font-serif text-5xl leading-[1.05] tracking-tight text-ink md:text-7xl">
        Tervetuloa Kannelkylään
      </h1>
      <p class="mt-6 max-w-3xl text-xl leading-relaxed text-ink/80">
        Kannelkylä on pientaloalue Helsingin Kannelmäessä, Kaarelan kaupunginosassa. Viiden hehtaarin tontti on vanhan
        Kannelmäen ja Malminkartanon välissä ja rajautuu Vanhaistentiehen, Jouhipolkuun ja Vantaanjoen entiseen
        lasku-uomaan Mätäjokeen. Vuonna 2014 Kannelkylä täytti neljäkymmentä vuotta.
      </p>
      <dl class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="rounded-2xl bg-paper px-4 py-4">
              <dt class="font-serif text-3xl tracking-tight text-forest">{stat.value}</dt>
              <dd class="text-sm text-muted">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto mt-16 grid max-w-6xl gap-12 px-5 lg:grid-cols-[1.3fr_0.7fr]">
    <div>
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-serif text-4xl tracking-tight text-ink">Uutiset</h2>
        <a href={url('/uutiset')} class="text-sm font-semibold text-moss underline-offset-4 hover:underline">Kaikki uutiset</a>
      </div>
      <ul class="mt-6 divide-y divide-line border-y border-line">
        {
          latest.map((item) => (
            <li>
              <a href={url(`/uutiset/${item.id}`)} class="group block py-5">
                <time datetime={item.data.date} class="text-sm font-semibold text-moss">
                  {formatDate(item.data.date)}
                </time>
                <p class="mt-1 font-serif text-2xl tracking-tight text-ink group-hover:text-forest">{item.data.title}</p>
                <p class="mt-2 max-w-2xl text-muted">{item.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="h-fit rounded-[1.75rem] bg-forest p-6 text-cream md:p-8">
      <p class="eyebrow text-cream/70">Yhteystiedot</p>
      <h2 class="mt-3 font-serif text-3xl">Isännöinti ja huolto</h2>
      <dl class="mt-6 space-y-4 text-cream/90">
        <div>
          <dt class="text-sm text-cream/60">Isännöitsijä</dt>
          <dd>Fortes Isännöinti Oy, Tanja Partanen</dd>
          <dd><a class="underline-offset-4 hover:underline" href="tel:+358442057935">044 205 7935</a></dd>
        </div>
        <div>
          <dt class="text-sm text-cream/60">Huolto, Kotikatu</dt>
          <dd>ma–pe 7–16, <a class="underline-offset-4 hover:underline" href="tel:+358102708250">010 270 8250</a></dd>
          <dd>Päivystys <a class="underline-offset-4 hover:underline" href="tel:+358102708888">010 270 8888</a></dd>
        </div>
      </dl>
      <a
        href={url('/yhteystiedot')}
        class="mt-8 inline-flex rounded-full bg-cream px-4 py-2 text-sm font-semibold text-forest"
      >
        Kaikki yhteystiedot
      </a>
    </aside>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-5">
    <h2 class="font-serif text-4xl tracking-tight">Asuminen ja eläminen</h2>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      Samat ohjeet kuin nykyisillä sivuilla: yhteiset tilat, remontit ja arjen asiat.
    </p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        categories.map((category) => (
          <a href={url(`/asuminen#${category.id}`)} class="rounded-[1.5rem] border border-line bg-cream p-6 hover:border-moss">
            <p class="font-serif text-2xl text-forest">{category.label}</p>
            <p class="mt-2 text-muted">{category.text}</p>
          </a>
        ))
      }
    </div>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        quick.map((item) => (
          <li>
            <a href={item.href} class="block rounded-2xl bg-white/60 px-4 py-4 hover:bg-cream">
              <p class="font-semibold">{item.title}</p>
              <p class="text-sm text-muted">{item.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto mt-20 grid max-w-6xl items-center gap-8 px-5 lg:grid-cols-2">
    <a href={url('/kylakartta')} class="overflow-hidden rounded-[1.75rem] bg-leaf">
      <img src={url('/media/kylankartta2.jpg')} alt="Kannelkylän kartta, jossa talot 12 A–14 T." class="w-full" />
    </a>
    <div>
      <p class="eyebrow">Löydä perille</p>
      <h2 class="mt-3 font-serif text-4xl tracking-tight">Kyläkartta</h2>
      <p class="mt-4 text-lg text-muted">
        Kylässä on 31 asuinrakennusta, tunnuksiltaan 12 A–12 N ja 14 A–14 T. Osoitteeseen kuuluu myös kirjain.
        Taloja 12 J, 14 J ja 14 Q ei ole.
      </p>
      <a href={url('/kylakartta')} class="mt-6 inline-flex font-semibold text-moss underline-offset-4 hover:underline">
        Avaa kartta ja PDF
      </a>
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-5 pb-4">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">1970-luku</p>
        <h2 class="mt-2 font-serif text-4xl tracking-tight">Kylä rakenteilla</h2>
      </div>
      <a href={url('/historia')} class="text-sm font-semibold text-moss underline-offset-4 hover:underline">Koko historia</a>
    </div>
    <ul class="mt-6 grid gap-3 sm:grid-cols-3">
      {
        [
          '/media/70s/1403503567481_1_orig.jpg',
          '/media/70s/1403504484469_1_orig.jpg',
          '/media/70s/1403504485137_1_orig.jpg',
        ].map((src, index) => (
          <li>
            <a href={url('/historia')}>
              <img
                src={url(src)}
                alt={`Mustavalkoinen kuva Kannelkylästä 1970-luvulta, ${index + 1}`}
                class="aspect-[4/3] w-full rounded-[1.4rem] object-cover"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
