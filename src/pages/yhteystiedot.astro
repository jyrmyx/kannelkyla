---
import { getEntry, render } from 'astro:content';
import Article from '../layouts/Article.astro';

const entry = await getEntry('pages', 'yhteystiedot');
if (!entry) throw new Error('Yhteystiedot puuttuvat');
const { Content } = await render(entry);
---

<Article title="Yhteystiedot" eyebrow="Asunto Oy Kannelmäen Pientalot" wide>
  <div class="prose mt-8 max-w-3xl">
    <Content />
  </div>
</Article>
