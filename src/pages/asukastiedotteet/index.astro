---
import { getEntry, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

const entry = await getEntry('pages', 'asukastiedotteet');
if (!entry) throw new Error('Asukastiedotteet puuttuvat');
const { Content } = await render(entry);
---

<Article title="Asukastiedotteet" eyebrow="Taloyhtiö" wide>
  <p class="mt-4 max-w-3xl text-lg text-muted">
    Vanhemmat PDF-tiedotteet avautuvat vielä nykyiseltä kannelkyla.fi-sivustolta. Vuosien 2014 tiedotteet ovat tässä
    luonnoksessa kokonaisina sivuina.
  </p>
  <div class="prose mt-8 max-w-3xl">
    <Content />
  </div>
</Article>
