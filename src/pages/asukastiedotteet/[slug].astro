---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  const bulletins = await getCollection('bulletins');
  return bulletins.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Article title={entry.data.title} eyebrow="Asukastiedote" wide>
  <div class="prose mt-8">
    <Content />
  </div>
  <p class="mt-12">
    <a href={url('/asukastiedotteet')} class="font-semibold text-moss underline-offset-4 hover:underline">
      ← Kaikki tiedotteet
    </a>
  </p>
</Article>
