---
import { getCollection } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { formatDate } from '../../lib/site';

const news = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Article title="Uutiset" eyebrow="Kannelkylä">
  <ul class="mt-10 divide-y divide-line border-y border-line">
    {
      news.map((item) => (
        <li>
          <a href={`/uutiset/${item.id}`} class="group block py-6">
            <time datetime={item.data.date} class="text-sm font-semibold text-moss">
              {formatDate(item.data.date)}
            </time>
            <p class="mt-1 font-serif text-3xl tracking-tight group-hover:text-forest">{item.data.title}</p>
            <p class="mt-2 text-muted">{item.data.summary}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Article>
