---
import { getEntry, render } from 'astro:content';
import Article from '../layouts/Article.astro';

const entry = await getEntry('pages', 'kylakartta');
if (!entry) throw new Error('Kyläkartta puuttuu');
const { Content } = await render(entry);
---

<Article title="Kyläkartta" eyebrow="12- ja 14-alue" wide>
  <div class="prose mt-8">
    <Content />
  </div>
</Article>
