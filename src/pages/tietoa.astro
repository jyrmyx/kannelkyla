---
import { getEntry, render } from 'astro:content';
import Article from '../layouts/Article.astro';

const entry = await getEntry('pages', 'tietoa');
if (!entry) throw new Error('Tietosivu puuttuu');
const { Content } = await render(entry);
---

<Article title="Tietoa Kannelkylästä" eyebrow="Kiinteistö" wide>
  <div class="prose mt-8">
    <Content />
  </div>
</Article>
